# Copy this file to .env and fill in values as needed.
# The app works with none of these set (falls back to a rule-based chatbot),
# but Gemini gives the best chatbot answers.

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model to use when GOOGLE_API_KEY is set
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama fallback (used when Gemini is unavailable or the key is missing)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Flask secret key (change for production)
FLASK_SECRET_KEY=dev-secret-change-me

# Path to the tesseract binary, only needed if it's not on PATH
TESSERACT_CMD=

# LLM-judged skill relatedness for skills the curated taxonomy doesn't cover
# (resume_matcher/skills_taxonomy.py). Off by default: a small local model
# (e.g. llama3.2:3b) was shown to reason unreliably about skill relatedness.
# Only enable this once you're using a model you trust for this judgment,
# such as Gemini (set GOOGLE_API_KEY above) or a larger local model you've
# verified yourself.
SKILL_ORACLE_ENABLED=true
